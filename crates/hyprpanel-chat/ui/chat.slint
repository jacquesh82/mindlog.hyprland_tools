import { SwatchRow, ChoiceOptionRow } from "choice-types.slint";
import { RichBlockRow, RichCellRow, RichTableRow } from "richtext-types.slint";
export { RichBlockRow, RichCellRow, RichTableRow } from "richtext-types.slint";
import { RichContent } from "rich-content.slint";
export { SwatchRow, ChoiceOptionRow } from "choice-types.slint";
import { Button, LineEdit, ComboBox, TextEdit, Palette, Spinner, CheckBox, ScrollView } from "std-widgets.slint";
import { Theme, Avatar, ActionButton, SuggestionCard, PanelHeader, ToolDetails, ChoiceCard } from "components.slint";
export { AvatarFrames } from "components.slint";

// ─── Structures de données ────────────────────────────────────────────────

// Ligne du journal : kind = "user" | "assistant" | "tool" | "error" | "status"
export struct MessageRow {
    kind: string,
    text: string,
    html: string,
    rich-blocks: [RichBlockRow],
    choices: [ChoiceOptionRow],
    choice-state: string,
}


// Pièce jointe en attente d'envoi (chip au-dessus de la saisie).
export struct AttachmentRow {
    name: string,
    meta: string,   // « 12 Ko · image » par ex.
}

// Entrée de l'historique de configuration (un tour = un prompt).
export struct HistoryRow {
    turn: string,      // « n°3 »
    preview: string,   // extrait du prompt
    meta: string,      // horodatage + nom du backup
    has-backup: bool,
    backup: string,    // nom du backup (vide si aucun)
}

// Dictionnaire i18n complet (FR/EN) — rempli par src/i18n.rs.
export struct TrTexts {
    send: string, cancel: string, save: string, close: string, new-chat: string,
    status-starting: string, status-thinking: string, status-writing: string, placeholder: string, attach: string,
    tip-help: string, tip-settings: string, tip-history: string,
    welcome-title: string, welcome-l1: string, welcome-l2: string, welcome-l3: string,
    header-subtitle: string, composer-hint: string,
    card-displays: string, card-appearance: string, card-shortcuts: string, card-capture: string,
    welcome-examples: string, ex1: string, ex2: string, ex3: string, ex4: string,
    help-title: string, help-body: string,
    about-title: string, about-body: string,
    settings-title: string, settings-language: string, settings-model: string,
    settings-endpoint: string, settings-max-tokens: string, settings-api-key: string,
    settings-clients: string, settings-clients-ok: string, settings-clients-missing: string,
    settings-saved: string, settings-invalid: string,
    settings-motion: string,
    settings-context: string, settings-context-hint: string, settings-context-invalid: string,
    fs-title: string, fs-body: string, fs-note: string, fs-allow: string, fs-refuse: string,
    fs-granted: string, fs-denied: string, fs-request: string, fs-revoke: string,
    command-title: string, command-note: string, command-run: string, command-decline: string,
    command-waiting: string, command-declined: string,
    environment-title: string, environment-note: string, environment-refresh: string,
    provider: string, subscription-hint: string,
    history-title: string, history-hint: string, history-empty: string,
    restore: string, restore-started: string, restore-done: string, restore-failed: string,
    no-backup: string, clients-notice: string,
    label-you: string, label-tool: string, label-error: string,
    show-tool-details: string, hide-tool-details: string, status-tools: string,
    choice-done: string, choice-skipped: string, choice-selected: string, preview-missing: string,
    new-conversation: string, mcp-unavailable: string, mcp-tools: string,
}


export component ChatWindow inherits Window {
    title: "LYRA — configuration Wayland";
    background: Theme.canvas;
    default-font-family: "sans-serif";
    default-font-size: 14px;
    preferred-width: 1080px;
    preferred-height: 800px;
    min-width: 480px;
    min-height: 600px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    // état i18n + UI
    in-out property <TrTexts> tr;
    in-out property <string> status: "…";
    in-out property <string> model-label: "";
    in-out property <int> provider-index: 0;
    in-out property <bool> busy: false;
    in-out property <string> activity: "thinking";
    in-out property <bool> animations-enabled: true;
    in-out property <float> avatar-time: -1;
    in-out property <bool> follow-output: true;
    in-out property <string> draft;
    in-out property <[MessageRow]> messages;
    in-out property <[AttachmentRow]> attachments;

    // overlays : "none" | "help" | "about" | "settings" | "history"
    in-out property <string> overlay: "none";

    // formulaire de réglages (rempli à l'ouverture par le Rust)
    in-out property <int> cfg-lang-index: 0;
    in-out property <string> cfg-model: "";
    in-out property <string> cfg-base-url: "";
    in-out property <string> cfg-max-tokens: "";
    in-out property <string> cfg-api-key: "";
    in-out property <string> settings-error;
    in-out property <bool> cfg-animate-avatar: true;
    in-out property <string> cfg-system-context;
    in-out property <bool> fs-approved: false;
    in-out property <string> fs-root: "~/.config";
    private property <string> fs-return-overlay: "none";
    callback filesystem-decision(bool);
    in-out property <int> command-id: 0;
    in-out property <string> command-text;
    in-out property <string> command-reason;
    callback command-decision(int, bool);
    in-out property <string> environment-text;
    callback refresh-environment();
    public function request-filesystem() {
        root.fs-return-overlay = root.overlay;
        root.overlay = "filesystem";
    }
    public function finish-filesystem(approved: bool) {
        root.fs-approved = approved;
        if root.overlay == "filesystem" {
            root.overlay = root.fs-return-overlay;
            root.fs-return-overlay = "none";
        }
    }
    in-out property <bool> clients-claude-ok: false;
    in-out property <bool> clients-zcode-ok: false;
    in-out property <string> clients-claude-cmd: "";
    in-out property <string> clients-zcode-cmd: "";

    in-out property <[HistoryRow]> history;
    in-out property <string> app-version: "";

    callback send(string);
    callback provider-selected(int);
    callback new-conversation();
    callback attach-clicked();
    callback remove-attachment(int);
    callback open-settings();
    callback close-overlay();
    callback save-settings();
    callback restore-requested(string);
    callback choice-selected(int, string);
    callback open-source(string);

    // La mesure intrinsèque ne dépend pas des décisions responsives.
    private property <length> view-width: 1080px;
    changed width => { root.view-width = root.width; }

    private property <length> column-width: min(root.view-width - 48px, 800px);
    private property <bool> interactive: !root.busy && root.overlay == "none";
    private property <bool> motion-allowed: root.animations-enabled && !root.minimized && root.overlay == "none";
    private property <float> motion-clock: 0;
    private property <float> avatar-phase: root.avatar-time >= 0 ? root.avatar-time : root.motion-clock;
    private property <bool> typing-active: false;
    public pure function animation-time() -> float { return root.motion-clock; }
    // Une seule horloge partagée, à 20 Hz, mise en pause pendant la saisie.
    // Pas de animation-tick() qui impose le rendu à chaque rafraîchissement écran.
    avatar-timer := Timer {
        interval: 50ms;
        running: root.motion-allowed && !root.typing-active && root.avatar-time < 0;
        triggered => { root.motion-clock += 0.05; }
    }
    typing-timer := Timer {
        interval: 250ms;
        running: false;
        triggered => { self.stop(); root.typing-active = false; }
    }

    public function scroll-bottom() {
        if root.messages.length == 0 {
            scroll-timer.stop();
            choice-timer.stop();
            flick.content-y = 0px;
        } else if root.follow-output {
            // Coalescer les fragments ; mesurer après la mise en page du texte.
            scroll-timer.start();
        }
    }

    public pure function is-at-bottom() -> bool {
        return flick.content-height + flick.content-y - flick.height <= 4px;
    }

    public pure function scroll-overflow() -> length {
        return max(0px, flick.content-height - flick.height);
    }
    public pure function scroll-position() -> length { return flick.content-y; }

    scroll-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            if root.follow-output {
                flick.content-y = min(0px, flick.height - flick.content-height);
            }
        }
    }

    private property <length> choice-anchor;
    private property <length> activity-row-height: 40px;
    public function prepare-choice() {
        root.follow-output = false;
        // Le choix est inséré avant l'indicateur transitoire de fin du journal.
        root.choice-anchor = root.messages.length == 0 ? 28px : log.preferred-height + 46px
            - (root.busy ? root.activity-row-height + log.spacing : 0px);
        choice-timer.start();
    }
    choice-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            flick.content-y = -min(root.choice-anchor, max(0px, flick.content-height - flick.height));
        }
    }

    public function focus-composer() { le.focus(); }

    public pure function activity-label() -> string {
        return root.activity == "writing" ? root.tr.status-writing
            : root.activity == "approval" ? root.tr.command-waiting
            : root.activity == "tools" ? root.tr.status-tools
            : root.activity == "restore" ? root.tr.restore-started
            : root.tr.status-thinking;
    }

    Rectangle {
        min-width: 0px;
        max-width: 16384px;
        preferred-width: 1080px;
        height: root.height;
        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;
            // Identité ancrée à gauche, actions à droite, sans compression du titre.
            Rectangle {
                height: 80px;
                background: Theme.canvas;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-left: root.view-width < 650px ? 16px : 28px;
                    padding-right: root.view-width < 650px ? 16px : 28px;
                    padding-top: 18px;
                    padding-bottom: 18px;
                    spacing: 12px;
                    Avatar {
                        width: 42px; height: 42px;
                        animated: root.motion-allowed;
                        engaged: root.busy;
                        time-override: root.avatar-phase;
                        blink-enabled: !root.typing-active;
                    }
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        Text { text: "LYRA"; color: Theme.text; font-size: 19px; font-weight: 700; }
                        if root.view-width > 680px: Text {
                            text: root.tr.header-subtitle;
                            color: Theme.muted;
                            font-size: 12px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        icon: @image-url("../assets/icons/history.svg");
                        text: root.tr.tip-history;
                        icon-only: true;
                        enabled: root.interactive;
                        clicked => { root.overlay = "history"; }
                    }
                    ActionButton {
                        icon: @image-url("../assets/icons/settings.svg");
                        text: root.tr.tip-settings;
                        icon-only: true;
                        enabled: root.interactive;
                        clicked => { root.open-settings(); }
                    }
                    ActionButton {
                        icon: @image-url("../assets/icons/help.svg");
                        text: root.tr.tip-help;
                        icon-only: true;
                        enabled: root.overlay == "none";
                        clicked => { root.overlay = "help"; }
                    }
                    Rectangle { width: 1px; background: Theme.border; }
                    ActionButton {
                        text: root.tr.new-chat;
                        icon: @image-url("../assets/icons/plus.svg");
                        icon-only: root.view-width < 650px;
                        filled: true;
                        enabled: root.interactive;
                        clicked => { root.new-conversation(); }
                    }
                }
            }

            // Une colonne de lecture stable, même lorsque la fenêtre est maximisée.
            flick := Flickable {
                flicked => { root.follow-output = false; }
                changed content-y => {
                    // Seul un geste utilisateur suspend le suivi ; une re-mesure
                    // pendant le streaming ne doit pas être prise pour ce geste.
                    if !root.follow-output && root.is-at-bottom() {
                        root.follow-output = true;
                    }
                }
                changed content-height => { root.scroll-bottom(); }
                changed height => { root.scroll-bottom(); }
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
                max-width: 16384px;
                min-height: 0px;
                max-height: 16384px;
                content-width: self.width;
                content-height: max(self.height, log.preferred-height + 56px);
                log := VerticalLayout {
                    x: (flick.width - self.width) / 2;
                    y: root.messages.length == 0 ? max(28px, (flick.height - self.preferred-height) / 2) : 28px;
                    width: root.column-width;
                    height: self.preferred-height;
                    spacing: 18px;

                    if root.messages.length == 0: VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            alignment: center;
                            Avatar {
                                width: root.view-width < 650px ? 72px : 100px;
                                height: self.width;
                                animated: root.motion-allowed && flick.content-y + log.y + 100px > 0px;
                                time-override: root.avatar-phase;
                                blink-enabled: !root.typing-active;
                            }
                        }
                        Rectangle { height: root.view-width < 650px ? 16px : 20px; }
                        Text {
                            text: root.tr.welcome-title;
                            color: Theme.text;
                            font-size: root.view-width < 650px ? 27px : 34px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Rectangle { height: root.view-width < 650px ? 8px : 12px; }
                        Text {
                            text: root.tr.welcome-l1;
                            color: Theme.secondary;
                            font-size: 15px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        Rectangle { height: root.view-width < 650px ? 20px : 28px; }
                        Text {
                            text: root.tr.welcome-examples;
                            color: Theme.muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                        Rectangle { height: root.view-width < 650px ? 10px : 14px; }
                        GridLayout {
                            spacing: 12px;
                            Row {
                                SuggestionCard {
                                    title: root.tr.card-displays;
                                    description: root.tr.ex1;
                                    icon: @image-url("../assets/icons/monitor.svg");
                                    enabled: root.interactive;
                                    clicked => { le.text = root.tr.ex1; le.focus(); }
                                }
                                SuggestionCard {
                                    title: root.tr.card-appearance;
                                    description: root.tr.ex2;
                                    icon: @image-url("../assets/icons/sliders.svg");
                                    enabled: root.interactive;
                                    clicked => { le.text = root.tr.ex2; le.focus(); }
                                }
                            }
                            Row {
                                SuggestionCard {
                                    title: root.tr.card-shortcuts;
                                    description: root.tr.ex3;
                                    icon: @image-url("../assets/icons/keyboard.svg");
                                    enabled: root.interactive;
                                    clicked => { le.text = root.tr.ex3; le.focus(); }
                                }
                                SuggestionCard {
                                    title: root.tr.card-capture;
                                    description: root.tr.ex4;
                                    icon: @image-url("../assets/icons/capture.svg");
                                    enabled: root.interactive;
                                    clicked => { le.text = root.tr.ex4; le.focus(); }
                                }
                            }
                        }
                        Rectangle { height: root.view-width < 650px ? 16px : 22px; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 7px;
                            Image {
                                width: 14px; height: 14px;
                                source: @image-url("../assets/icons/shield.svg");
                                colorize: Theme.muted;
                            }
                            Text {
                                text: root.tr.welcome-l2;
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    for row[i] in root.messages: Rectangle {
                        height: message.preferred-height;
                        message := VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            if row.kind == "tool": ToolDetails {
                                details: row.text;
                                show-label: root.tr.show-tool-details;
                                hide-label: root.tr.hide-tool-details;
                                toggled => { root.follow-output = false; }
                            }
                            if row.kind == "choice": VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: row.text;
                                    color: Theme.text;
                                    font-size: 16px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                for option in row.choices: ChoiceCard {
                                    label: option.label;
                                    description: option.description;
                                    swatches: option.swatches;
                                    colors-text: option.colors-text;
                                    preview: option.preview;
                                    preview-missing: option.preview-missing;
                                    missing-label: root.tr.preview-missing;
                                    source: option.source;
                                    source-label: option.source-label;
                                    selected: option.selected;
                                    enabled: root.interactive && row.choice-state == "pending";
                                    invoked => { root.choice-selected(i, option.id); }
                                    source-clicked => { root.open-source(option.source); }
                                }
                                if row.choice-state != "pending": Text {
                                    text: row.choice-state == "selected" ? root.tr.choice-done : root.tr.choice-skipped;
                                    color: Theme.muted;
                                    font-size: 12px;
                                }
                            }
                            if row.kind != "tool" && row.kind != "choice": HorizontalLayout {
                                width: parent.width;
                                spacing: 12px;
                                if row.kind == "user": Rectangle { horizontal-stretch: 1; }
                                if row.kind == "assistant": Avatar { width: 32px; height: 32px; }
                                Rectangle {
                                    horizontal-stretch: row.kind == "user" ? 0 : 1;
                                    width: row.kind == "user" ? min(root.column-width * 0.85, body.preferred-width + 36px) : root.column-width - 44px;
                                    height: body.preferred-height + 28px;
                                    border-radius: 14px;
                                    background: row.kind == "user" ? #1C323B : row.kind == "error" ? #291C25 : row.kind == "status" ? transparent : Theme.panel;
                                    border-width: row.kind == "status" ? 0px : 1px;
                                    border-color: row.kind == "error" ? #67404E : row.kind == "user" ? #2B4C55 : Theme.border;
                                    body := VerticalLayout {
                                        x: 18px; y: 14px;
                                        width: parent.width - 36px;
                                        height: self.preferred-height;
                                        spacing: 7px;
                                        if row.kind != "status": Text {
                                            text: row.kind == "user" ? root.tr.label-you : row.kind == "assistant" ? "LYRA" : row.kind == "tool" ? root.tr.label-tool : root.tr.label-error;
                                            color: row.kind == "error" ? #F3A9B7 : row.kind == "assistant" ? Theme.accent : Theme.secondary;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                        if row.kind == "assistant" && row.rich-blocks.length > 0: RichContent {
                                            blocks: row.rich-blocks;
                                            open-link(url) => { root.open-source(url); }
                                        }
                                        if row.kind != "assistant" || row.rich-blocks.length == 0: Text {
                                            text: row.text;
                                            color: row.kind == "error" ? #F3C6D0 : row.kind == "tool" || row.kind == "status" ? Theme.secondary : Theme.text;
                                            font-size: row.kind == "tool" || row.kind == "status" ? 12px : 14px;
                                            font-family: row.kind == "tool" ? "monospace" : root.default-font-family;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Indicateur transitoire : indépendant des messages et détails d'outils.
                    if root.busy: HorizontalLayout {
                        height: root.activity-row-height;
                        spacing: 10px;
                        Avatar {
                            width: 32px; height: 32px;
                            animated: root.motion-allowed && root.follow-output;
                            engaged: true;
                            time-override: root.avatar-phase;
                            blink-enabled: !root.typing-active;
                        }
                        Spinner {
                            width: 16px; height: 16px; y: 12px;
                            indeterminate: true;
                            accessible-label: root.activity-label();
                        }
                        Text {
                            text: root.activity-label();
                            color: Theme.secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            // Compositeur : champ large, pièces jointes et action principale visibles.
            Rectangle {
                height: root.attachments.length > 0 ? 188px : 146px;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 0px;
                    width: root.column-width;
                    height: root.attachments.length > 0 ? 146px : 104px;
                    border-radius: 16px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: le.has-focus ? Theme.accent : Theme.border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        if root.attachments.length > 0: Flickable {
                            height: 34px;
                            content-width: chips.preferred-width;
                            content-height: self.height;
                            chips := HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                for a[i] in root.attachments: ActionButton {
                                    text: a.name + "  ×";
                                    a11y-label: root.tr.close + " " + a.name;
                                    filled: true;
                                    height: 32px;
                                    enabled: root.interactive;
                                    clicked => { root.remove-attachment(i); }
                                }
                            }
                        }
                        le := LineEdit {
                            text <=> root.draft;
                            height: 36px;
                            placeholder-text: root.tr.placeholder;
                            accessible-label: root.tr.placeholder;
                            enabled: root.interactive;
                            edited => {
                                root.typing-active = true;
                                typing-timer.start();
                                typing-timer.restart();
                            }
                            accepted(t) => {
                                if t != "" || root.attachments.length > 0 {
                                    root.send(t);
                                    le.text = "";
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                text: root.tr.attach;
                                icon: @image-url("../assets/icons/paperclip.svg");
                                height: 32px;
                                enabled: root.interactive;
                                clicked => { root.attach-clicked(); }
                            }
                            ComboBox {
                                model: ["Zcode", "Claude Code", "Codex"];
                                current-index <=> root.provider-index;
                                accessible-label: root.tr.provider;
                                enabled: root.interactive;
                                height: 32px;
                                min-width: 140px;
                                preferred-width: 150px;
                                max-width: 170px;
                                selected => { root.provider-selected(self.current-index); }
                            }
                            Text {
                                text: root.model-label;
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            ActionButton {
                                text: root.tr.send;
                                icon: @image-url("../assets/icons/arrow-up.svg");
                                primary: true;
                                height: 32px;
                                enabled: root.interactive && (le.text != "" || root.attachments.length > 0);
                                clicked => {
                                    root.send(le.text);
                                    le.text = "";
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 30px;
                    width: root.column-width;
                    height: 18px;
                    spacing: 8px;
                    Rectangle {
                        width: 6px; height: 6px; y: 6px;
                        border-radius: 3px;
                        background: root.busy ? #DFB870 : Theme.muted;
                    }
                    Text {
                        text: root.busy ? root.activity-label() : root.status;
                        color: Theme.secondary;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.view-width > 600px: Text {
                        text: root.tr.composer-hint;
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }

    }

    // ── Overlays modaux ──────────────────────────────────────────────────
    if root.overlay != "none": Rectangle {
        background: #000000B3;
        TouchArea {
            clicked => { root.close-overlay(); }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close-overlay();
                    return accept;
                }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(root.view-width - 40px, 560px);
                height: min(root.height - 60px, root.overlay == "settings" ? 740px : root.overlay == "filesystem" ? 440px : 560px);
                border-radius: 14px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 20px;
                drop-shadow-color: #000000AA;

                // Les clics dans le panneau ne traversent pas vers le fond.
                TouchArea { }

                VerticalLayout {
                    padding: 24px;
                    spacing: 10px;

                    if root.overlay == "command": VerticalLayout {
                        spacing: 14px;
                        Timer {
                            private property <int> focused-id: -1;
                            interval: 1ms;
                            running: self.focused-id != root.command-id;
                            triggered => { self.focused-id = root.command-id; command-decline.focus(); }
                        }
                        PanelHeader {
                            title: root.tr.command-title;
                            close-label: root.tr.close;
                            close => { root.close-overlay(); }
                        }
                        Text { text: root.command-reason; color: Theme.text; wrap: word-wrap; font-size: 14px; }
                        TextEdit {
                            text: root.command-text;
                            read-only: true;
                            accessible-label: root.tr.command-title;
                            wrap: word-wrap;
                            font-family: "monospace";
                            vertical-stretch: 1;
                        }
                        Text { text: root.tr.command-note; color: Theme.secondary; wrap: word-wrap; font-size: 13px; }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 12px;
                            command-decline := ActionButton {
                                text: root.tr.command-decline;
                                clicked => { root.command-decision(root.command-id, false); }
                            }
                            ActionButton { text: root.tr.command-run; primary: true; clicked => { root.command-decision(root.command-id, true); } }
                        }
                    }

                    if root.overlay == "filesystem": VerticalLayout {
                        spacing: 16px;
                        PanelHeader {
                            title: root.tr.fs-title;
                            close-label: root.tr.close;
                            close => { root.close-overlay(); }
                        }
                        Text { text: root.tr.fs-body; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                        Rectangle {
                            background: Theme.canvas;
                            border-radius: 8px;
                            height: fs-path.preferred-height + 24px;
                            fs-path := Text {
                                x: 12px; y: 12px; width: parent.width - 24px;
                                text: root.fs-root; color: Theme.accent; font-size: 14px; wrap: word-wrap;
                            }
                        }
                        Text { text: root.tr.fs-note; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 12px;
                            ActionButton { text: root.tr.fs-refuse; clicked => { root.filesystem-decision(false); } }
                            ActionButton { text: root.tr.fs-allow; primary: true; clicked => { root.filesystem-decision(true); } }
                        }
                    }

                    // ── AIDE ──────────────────────────────────────────────
                    if root.overlay == "help": VerticalLayout {
                        spacing: 8px;
                        PanelHeader {
                            close-label: root.tr.close;
                            title: root.tr.help-title;
                            close => { root.close-overlay(); }
                        }
                        TextEdit {
                            vertical-stretch: 1;
                            read-only: true;
                            wrap: word-wrap;
                            text: root.tr.help-body;
                            font-size: 14px;
                        }
                        ActionButton {
                            text: root.tr.about-title;
                            clicked => { root.overlay = "about"; }
                        }
                    }

                    // ── À PROPOS ──────────────────────────────────────────
                    if root.overlay == "about": VerticalLayout {
                        spacing: 8px;
                        PanelHeader {
                            close-label: root.tr.close;
                            title: root.tr.about-title;
                            close => { root.close-overlay(); }
                        }
                        TextEdit {
                            vertical-stretch: 1;
                            read-only: true;
                            wrap: word-wrap;
                            text: root.tr.about-body;
                            font-size: 14px;
                        }
                    }

                    // ── RÉGLAGES ──────────────────────────────────────────
                    if root.overlay == "settings": VerticalLayout {
                        spacing: 8px;
                        PanelHeader {
                            close-label: root.tr.close;
                            title: root.tr.settings-title;
                            close => { root.close-overlay(); }
                        }
                        if root.settings-error != "": Text {
                            text: root.settings-error;
                            color: #F3A9B7;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        settings-scroll := ScrollView {
                            vertical-stretch: 1;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            max-width: 16384px;
                            horizontal-scrollbar-policy: always-off;
                            content-width: self.visible-width;
                            content-height: settings-content.preferred-height;
                            settings-content := VerticalLayout {
                                width: settings-scroll.visible-width;
                                height: self.preferred-height;
                                padding: 2px;
                                padding-right: 16px;
                                spacing: 8px;
                                setform := VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.tr.settings-language;
                                        color: Theme.secondary;
                                        font-size: 13px;
                                    }
                                    ComboBox {
                                        model: ["Français", "English"];
                                        current-index <=> root.cfg-lang-index;
                                    }
                                    CheckBox {
                                        text: root.tr.settings-motion;
                                        checked <=> root.cfg-animate-avatar;
                                    }
                                    HorizontalLayout {
                                        min-height: 38px;
                                        spacing: 12px;
                                        Text {
                                            text: root.fs-approved ? root.tr.fs-granted : root.tr.fs-denied;
                                            color: Theme.secondary;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        ActionButton {
                                            text: root.fs-approved ? root.tr.fs-revoke : root.tr.fs-request;
                                            filled: true;
                                            clicked => {
                                                if root.fs-approved { root.filesystem-decision(false); }
                                                else { root.request-filesystem(); }
                                            }
                                        }
                                    }
                                    if root.provider-index != 0: Text {
                                        text: root.tr.subscription-hint;
                                        color: Theme.secondary;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: root.tr.settings-model;
                                        color: Theme.secondary;
                                        font-size: 13px;
                                    }
                                    LineEdit { text <=> root.cfg-model; accessible-label: root.tr.settings-model; }
                                    if root.provider-index == 0: Text {
                                        text: root.tr.settings-endpoint;
                                        color: Theme.secondary;
                                        font-size: 13px;
                                    }
                                    if root.provider-index == 0: LineEdit { text <=> root.cfg-base-url; accessible-label: root.tr.settings-endpoint; read-only: true; }
                                    if root.provider-index == 0: Text {
                                        text: root.tr.settings-max-tokens;
                                        color: Theme.secondary;
                                        font-size: 13px;
                                    }
                                    if root.provider-index == 0: LineEdit {
                                        text <=> root.cfg-max-tokens;
                                        accessible-label: root.tr.settings-max-tokens;
                                        input-type: InputType.number;
                                    }
                                    if root.provider-index == 0: Text {
                                        text: root.tr.settings-api-key;
                                        color: Theme.secondary;
                                        font-size: 13px;
                                    }
                                    if root.provider-index == 0: LineEdit {
                                        text <=> root.cfg-api-key;
                                        accessible-label: root.tr.settings-api-key;
                                        input-type: InputType.password;
                                    }
                                    Text {
                                        text: root.tr.settings-context;
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.tr.settings-context-hint;
                                        color: Theme.secondary;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    TextEdit {
                                        text <=> root.cfg-system-context;
                                        accessible-label: root.tr.settings-context;
                                        height: 160px;
                                        wrap: word-wrap;
                                        font-size: 13px;
                                    }
                                    Text { text: root.tr.environment-title; color: Theme.text; font-size: 14px; font-weight: 600; }
                                    Text { text: root.tr.environment-note; color: Theme.secondary; wrap: word-wrap; font-size: 12px; }
                                    TextEdit {
                                        text: root.environment-text;
                                        accessible-label: root.tr.environment-title;
                                        read-only: true;
                                        height: 180px;
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }
                                    ActionButton {
                                        text: root.tr.environment-refresh;
                                        enabled: root.fs-approved;
                                        clicked => { root.refresh-environment(); }
                                    }
                                    Text {
                                        text: root.tr.settings-clients;
                                        color: Theme.secondary;
                                        font-size: 13px;
                                    }
                                    Text {
                                        text: "Claude Code : " + (root.clients-claude-ok ? root.tr.settings-clients-ok : root.tr.settings-clients-missing);
                                        color: root.clients-claude-ok ? #4ADE80 : #FDA4AF;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    if !root.clients-claude-ok: Text {
                                        text: root.clients-claude-cmd;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        font-family: "monospace";
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "ZCode : " + (root.clients-zcode-ok ? root.tr.settings-clients-ok : root.tr.settings-clients-missing);
                                        color: root.clients-zcode-ok ? #4ADE80 : #FDA4AF;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    if !root.clients-zcode-ok: Text {
                                        text: root.clients-zcode-cmd;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        font-family: "monospace";
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            ActionButton {
                                text: root.tr.cancel;
                                clicked => { root.close-overlay(); }
                            }
                            ActionButton {
                                text: root.tr.save;
                                primary: true;
                                clicked => { root.save-settings(); }
                            }
                        }
                    }

                    // ── HISTORIQUE ────────────────────────────────────────
                    if root.overlay == "history": VerticalLayout {
                        spacing: 8px;
                        PanelHeader {
                            close-label: root.tr.close;
                            title: root.tr.history-title;
                            close => { root.close-overlay(); }
                        }
                        Text {
                            text: root.tr.history-hint;
                            color: Theme.secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.history.length == 0: Text {
                            text: root.tr.history-empty;
                            color: Theme.muted;
                            font-size: 14px;
                        }
                        Flickable {
                            vertical-stretch: 1;
                            content-height: histlist.preferred-height;
                            VerticalLayout {
                                padding: 2px;
                                spacing: 6px;
                                histlist := VerticalLayout {
                                    spacing: 6px;
                                    for rec in root.history: Rectangle {
                                        border-radius: 8px;
                                        background: Theme.canvas;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        height: hrow.preferred-height + 12px;
                                        hrow := HorizontalLayout {
                                            x: 8px; y: 6px;
                                            width: parent.width - 16px;
                                            spacing: 8px;
                                            alignment: center;
                                            VerticalLayout {
                                                spacing: 1px;
                                                horizontal-stretch: 1;
                                                Text {
                                                    text: rec.turn + " · " + rec.preview;
                                                    color: Theme.text;
                                                    font-size: 14px;
                                                    wrap: word-wrap;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: rec.meta;
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    font-family: "monospace";
                                                    overflow: elide;
                                                }
                                            }
                                            if rec.has-backup: ActionButton {
                                                text: root.tr.restore;
                                                enabled: root.fs-approved;
                                                clicked => {
                                                    root.close-overlay();
                                                    root.restore-requested(rec.backup);
                                                }
                                            }
                                            if !rec.has-backup: Text {
                                                text: root.tr.no-backup;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
